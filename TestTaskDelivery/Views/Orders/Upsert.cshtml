@model OrderRequest
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Редактирование заказа" : "Добавление заказа";
}

<partial name="_PageFormHeader" model=@ViewData["Title"] />
<form method="post">
    @Html.AntiForgeryToken()
   
    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="SenderCityId" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <div class="flex-grow-1  w-100 field-max-width">
            <select asp-for="SenderCityId" id="SenderCitySelect" >
                <option value=""></option>
                @if (isEdit && Model.SenderCityId != 0)
                {
                    <option value="@Model.SenderCityId" selected>@ViewBag.SelectedSenderCity</option>
                }
            </select>
        </div>
    </div>
    @Html.EditorFor(m => m.SenderAddress, "String")
    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="ReceiverCityId" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <div class="flex-grow-1 w-100 field-max-width">
            <select asp-for="ReceiverCityId" id="ReceiverCitySelect">
                <option value=""></option>
                @if (isEdit && Model.ReceiverCityId != 0)
                {
                    <option value="@Model.ReceiverCityId" selected>@ViewBag.SelectedReceiverCity</option>
                }
            </select>
        </div>
    </div>
    @Html.EditorFor(m => m.ReceiverAddress, "String")
    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="@Model.Weight" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <input asp-for="Weight" type="number" step="0.01" class="form-control flex-grow-1 field-max-width" placeholder="0.00"/>
    </div>
    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="PickupDate" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <input asp-for="PickupDate" type="datetime-local" class="form-control" style="width: auto;" />
    </div>

    <div class="d-flex justify-content-start gap-2 mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary" style="width: 120px;">
            Отмена
        </a>
        <button type="submit" class="btn btn-primary" style="width: 120px;">
            @(isEdit ? "Сохранить" : "Добавить")
        </button>
    </div>
</form>

@section Scripts {
    <script>
        initializeCitySelect('#SenderCitySelect', '/api/cities/search');
        initializeCitySelect('#ReceiverCitySelect', '/api/cities/search');
    </script>
}