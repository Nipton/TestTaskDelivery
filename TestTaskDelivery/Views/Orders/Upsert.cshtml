@using Microsoft.AspNetCore.Mvc.ModelBinding
@model OrderRequest
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Редактирование заказа" : "Добавление заказа";
}

<partial name="_PageFormHeader" model=@ViewData["Title"] />
@{
    // Берём только ошибки, которые НЕ связаны с валидацией полей
    var serverErrors = ViewContext.ModelState
        .Where(x => x.Key == "" || x.Key == string.Empty)
        .SelectMany(v => v.Value?.Errors ?? new ModelErrorCollection())
        .FirstOrDefault()?.ErrorMessage;
}

@if (!string.IsNullOrEmpty(serverErrors))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @serverErrors
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<form method="post">
    @Html.AntiForgeryToken()
   
    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="SenderCityId" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <div class="flex-grow-1  w-100 field-max-width">
            <select asp-for="SenderCityId" id="SenderCitySelect" >
                <option value=""></option>
                @if (Model.SenderCityId != 0)
                {
                    <option value="@Model.SenderCityId" selected>@ViewBag.SelectedSenderCity</option>
                }
            </select>
            <span asp-validation-for="SenderCityId" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="@Model.SenderAddress" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold" style="width: 180px;"></label>
        <div class="flex-grow-1 w-100 field-max-width">
            <textarea asp-for="SenderAddress" class="form-control flex-grow-1 field-max-width" placeholder="Введите адрес..."></textarea>
            <span asp-validation-for="SenderAddress" class="text-danger mt-1"></span>
        </div>
    </div>

    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="ReceiverCityId" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <div class="flex-grow-1 w-100 field-max-width">
            <select asp-for="ReceiverCityId" id="ReceiverCitySelect">
                <option value=""></option>
                @if (Model.ReceiverCityId != 0)
                {
                    <option value="@Model.ReceiverCityId" selected>@ViewBag.SelectedReceiverCity</option>
                }
            </select>
            <span asp-validation-for="ReceiverCityId" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="@Model.ReceiverAddress" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold" style="width: 180px;"></label>
        <div class="flex-grow-1 w-100 field-max-width">
            <textarea asp-for="ReceiverAddress" class="form-control flex-grow-1 field-max-width" placeholder="Введите адрес..."></textarea>
            <span asp-validation-for="ReceiverAddress" class="text-danger mt-1"></span>
        </div>
    </div>

    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="@Model.Weight" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <div class="flex-grow-1 w-100 field-max-width">
            <input asp-for="Weight" type="number" step="0.01" class="form-control flex-grow-1 field-max-width" onclick="this.select()" />
            <span asp-validation-for="Weight" class="text-danger mt-1"></span>
        </div>
    </div>

    <div class="d-flex align-items-center mb-3 flex-column flex-md-row">
        <label asp-for="@Model.PickupDate" class="flex-shrink-0 mb-2 mb-md-0 fw-semibold label-max-width"></label>
        <div class="flex-grow-1 w-100 field-max-width">
            <input asp-for="PickupDate" type="datetime-local" class="form-control" style="width: auto;" />
            <span asp-validation-for="PickupDate" class="text-danger mt-1"></span>
        </div>
    </div>

    <div class="d-flex justify-content-start gap-2 mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary" style="width: 120px;">
            Отмена
        </a>
        <button type="submit" class="btn btn-primary" style="width: 120px;">
            @(isEdit ? "Сохранить" : "Добавить")
        </button>
    </div>
</form>

@section Scripts {
    <script>
        initializeCitySelect('#SenderCitySelect', '/api/cities/search');
        initializeCitySelect('#ReceiverCitySelect', '/api/cities/search');
        fixEmptyCityFields();
    </script>
}